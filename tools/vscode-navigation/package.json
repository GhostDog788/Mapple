{
  "name": "navigation",
  "displayName": "Mapple Navigation",
  "description": "Matching-kernel source navigation and synchronized GDB controls for Mapple.",
  "publisher": "mapple",
  "version": "0.2.0",
  "engines": {"vscode": "^1.90.0"},
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "extensionDependencies": ["llvm-vs-code-extensions.vscode-clangd"],
  "activationEvents": ["workspaceContains:scripts/lab.py"],
  "capabilities": {"untrustedWorkspaces": {"supported": false}},
  "contributes": {
    "debuggers": [{
      "type": "mapple-kernel", "label": "Mapple kernel (GDB)",
      "languages": ["c", "cpp"],
      "configurationAttributes": {
        "launch": {"required": ["program", "miDebuggerPath"], "properties": {
          "program": {"type": "string", "description": "Frozen Mapple symbol ELF generated by make vscode-open."},
          "miDebuggerPath": {"type": "string", "description": "Generated GDB wrapper for this run."},
          "cwd": {"type": "string", "description": "Repository working directory."},
          "MIMode": {"enum": ["gdb"], "default": "gdb"},
          "miDebuggerServerAddress": {"type": "string", "description": "QEMU/KGDB endpoint for the frozen machine."},
          "customLaunchSetupCommands": {"type": "array", "items": {"type": "object", "properties": {
            "text": {"type": "string"}, "ignoreFailures": {"type": "boolean"}
          }}},
          "launchCompleteCommand": {"enum": ["exec-continue", "None"], "default": "exec-continue"},
          "targetArchitecture": {"type": "string"},
          "externalConsole": {"type": "boolean", "default": false},
          "logging": {"type": "object", "description": "Microsoft C/C++ adapter logging options."}
        }}
      }
    }],
    "commands": [
      {"command": "mapple.navigation.prepare", "title": "Mapple: Prepare source navigation"},
      {"command": "mapple.navigation.status", "title": "Mapple: Show navigation status"}
    ],
    "configuration": {
      "title": "Mapple",
      "properties": {
        "mapple.navigation.labDirectory": {"type": "string", "default": ".lab", "scope": "resource", "description": "Local lab directory, relative to this checkout or absolute."}
      }
    }
  }
}
