[Unit]
Description=mapple control-plane daemon
Documentation=https://github.com/GhostDog788/Mapple/blob/main/docs/guides/server-installation.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mappled -config /etc/mapple/mappled.json
Restart=on-failure
RestartSec=2s

# The service opens operator-supplied TCP destinations and character-device
# paths as root (docs/architecture/overview.md). DevicePolicy/DeviceAllow are not set
# because destinations are supplied at session creation.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=

# Lease state lives in memory; only configuration and TLS material are read.
ReadOnlyPaths=/etc/mapple

[Install]
WantedBy=multi-user.target
