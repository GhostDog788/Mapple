# Copy to lab.local.env (gitignored) and edit for your machines.
#
# Program/module names are NOT set here: the module name lives in
# kernel/Kbuild (obj-m), the binary name in user/Makefile (BIN); scripts
# discover both from the build outputs.

# Local tools; override only if not on $PATH.
SSH_BIN=ssh
SCP_BIN=scp
RSYNC_BIN=rsync
SSHPASS_BIN=sshpass

# Target profiles. Every TARGET_* map below is keyed by these names.
TARGETS=(desktop server)

# Only ubuntu targets are implemented.
declare -A TARGET_OS=(
  [desktop]=ubuntu
  [server]=ubuntu
)

# Target address (IP or resolvable hostname) on the LAN shared with this
# host; used for all ssh/scp/rsync. The debug endpoints below are separate
# on purpose: gdb stubs listen on the hypervisor host, not at this address.
declare -A TARGET_IP=(
  [desktop]=ubuntu-desktop.local
  [server]=ubuntu-server.local
)

declare -A TARGET_SSH_PORT=(
  [desktop]=22
  [server]=22
)

declare -A TARGET_SSH_USER=(
  [desktop]=user
  [server]=user
)

# SSH password; empty = use SSH keys (recommended). Piped via SSHPASS,
# never written to disk or visible in ps.
declare -A TARGET_SSH_PASS=(
  [desktop]=
  [server]=
)

# Sudo password; empty = reuse TARGET_SSH_PASS (or configure NOPASSWD).
declare -A TARGET_SUDO_PASS=(
  [desktop]=
  [server]=
)

# Remote staging dir for uploads; empty = /tmp/kmod-debug-lab-<ssh-user>.
declare -A TARGET_REMOTE_DIR=(
  [desktop]=
  [server]=
)

# Debug endpoints, one per method (scripts 01/04 take <kgdb|qemu>).
# May be left empty per target if you don't use that method.

# KGDB-over-serial: TCP bridge to the target's serial port (socat, QEMU
# `-serial tcp:...,server,nowait`, VMware named-pipe bridge).
declare -A TARGET_DEBUG_ENDPOINT_KGDB=(
  [desktop]=127.0.0.1:5510
  [server]=127.0.0.1:5520
)

# QEMU gdbstub (`-gdb tcp::PORT` / `-s`); VMware debugStub too.
declare -A TARGET_DEBUG_ENDPOINT_QEMU=(
  [desktop]=127.0.0.1:1234
  [server]=127.0.0.1:1234
)

# Usermode gdbserver port; GDB connects directly to TARGET_IP:PORT (no
# tunnel, port must be reachable). Empty = 2345. Env override: LAB_GDB_PORT.
declare -A TARGET_USER_GDB_PORT=(
  [desktop]=2345
  [server]=2345
)

# Serial KGDB settings (kgdb method only).
declare -A TARGET_KGDB_TTY=(
  [desktop]=ttyS0
  [server]=ttyS0
)

declare -A TARGET_KGDB_BAUD=(
  [desktop]=115200
  [server]=115200
)

# Optional: pin the target's CPU count via GRUB maxcpus=.
#DEBUG_MAXCPUS=1

# Optional: scripts/04 poll deadline for /sys/module/<name>/sections/. Default 30.
#INSMOD_WAIT_SECS=30
