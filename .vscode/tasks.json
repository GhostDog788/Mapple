{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "kernelTarget",
      "type": "promptString",
      "description": "Kernel target profile (a name from TARGETS in lab.local.env)",
      "default": "server"
    },
    {
      "id": "debugMethod",
      "type": "pickString",
      "description": "Kernel debug method",
      "options": [
        "kgdb",
        "qemu"
      ],
      "default": "qemu"
    },
    {
      "id": "moduleParams",
      "type": "promptString",
      "description": "insmod parameters for the kernel module (key=value ...; leave empty for none)",
      "default": ""
    }
  ],
  "tasks": [
    {
      "label": "Build: Kernel Module",
      "detail": "kernel/scripts/03-build-module.sh — cross-build the module for a target",
      "type": "shell",
      "command": "./kernel/scripts/03-build-module.sh ${input:kernelTarget}",
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build: Usermode (Go)",
      "detail": "make user — go build/vet/test for the user/ Go module",
      "type": "shell",
      "command": "make user",
      "group": "build",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Kernel: Check Target",
      "type": "shell",
      "command": "./kernel/scripts/00-check-target.sh ${input:kernelTarget} ${input:debugMethod}",
      "problemMatcher": []
    },
    {
      "label": "Kernel: Provision Target",
      "type": "shell",
      "command": "./kernel/scripts/01-provision-target.sh ${input:kernelTarget} ${input:debugMethod}",
      "problemMatcher": []
    },
    {
      "label": "Kernel: Setup Host Build",
      "type": "shell",
      "command": "./kernel/scripts/02-setup-host-build.sh ${input:kernelTarget}",
      "problemMatcher": []
    },
    {
      "label": "Kernel: Deploy + Prep GDB",
      "type": "shell",
      "command": "./kernel/scripts/04-deploy-and-prep-gdb.sh ${input:kernelTarget} ${input:debugMethod} ${input:moduleParams}",
      "problemMatcher": []
    },
    {
      "label": "Kernel: GDB (tui)",
      "type": "shell",
      "command": "./kernel/scripts/04-deploy-and-prep-gdb.sh ${input:kernelTarget} ${input:debugMethod} ${input:moduleParams} && gdb -tui ${workspaceFolder}/kernel/.gdb/current-vmlinux -x ${workspaceFolder}/kernel/.gdb/current-debug.gdb",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
