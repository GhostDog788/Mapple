{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kernel: cppdbg (full GDB MI)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/kernel/.gdb/current-vmlinux",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "targetArchitecture": "x64",
      "preLaunchTask": "Kernel: Deploy + Prep GDB",
      "externalConsole": false,
      "miDebuggerServerAddress": "active-vm:0",
      "customLaunchSetupCommands": [
        {
          "description": "Connect using the active slot script. The server address marks this as remote; custom setup supplies the actual endpoint.",
          "text": "source ${workspaceFolder}/kernel/.gdb/current-debug.gdb",
          "ignoreFailures": false
        }
      ],
      "launchCompleteCommand": "exec-continue"
    }
  ]
}
