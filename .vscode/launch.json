{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kernel: cppdbg (full GDB MI)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/kernel/.gdb/current-vmlinux",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "targetArchitecture": "x64",
      "preLaunchTask": "Kernel: Deploy + Prep GDB",
      "setupCommands": [
        {
          "description": "Source the GDB init script generated by kernel/scripts/04",
          "text": "source ${workspaceFolder}/kernel/.gdb/current-debug.gdb",
          "ignoreFailures": false
        }
      ],
      "launchCompleteCommand": "exec-continue",
      "externalConsole": false
    },
    {
      "name": "Usermode: remote (gdbserver)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/user/build/current",
      "cwd": "${workspaceFolder}/user",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "targetArchitecture": "x64",
      "preLaunchTask": "Usermode: Deploy + gdbserver",
      "setupCommands": [
        {
          "description": "Endpoint comes from lab.local.env via user/scripts/deploy-and-debug.sh",
          "text": "source ${workspaceFolder}/user/.gdb/current-debug.gdb",
          "ignoreFailures": false
        }
      ],
      "launchCompleteCommand": "exec-continue",
      "externalConsole": false
    }
  ]
}
