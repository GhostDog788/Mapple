{
  "C_Cpp.default.configurationName": "Kernel",
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "${workspaceFolder}/scripts/clangd.py",
  "files.associations": {
    "*.h": "c",
    "*.c": "c",
    "Kbuild": "makefile"
  },
  "files.exclude": {
    ".cache": true,
    "compile_commands.json": true,
    "*/compile_commands.json": true,
    ".lab": true
  },
  "files.watcherExclude": {
    "**/.lab/**": true
  }
}
