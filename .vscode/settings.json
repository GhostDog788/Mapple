{
  "C_Cpp.default.configurationName": "Kernel",
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "/usr/bin/clangd-18",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--background-index",
    "--header-insertion=never",
    "--clang-tidy=false"
  ],
  "files.associations": {
    "*.h": "c",
    "*.c": "c",
    "Kbuild": "makefile"
  },
  "files.exclude": {
    "kernel/.gdb": true,
    "kernel/build": true,
    ".cache": true,
    "compile_commands.json": true,
    "*/compile_commands.json": true,
    "*/module_compile_commands.json": true,
    "*/linux_compile_commands.json": true,
    ".lab": true,
    "kernel/kernel-cache": true
  },
  "files.watcherExclude": {
    "**/.lab/**": true,
    "**/kernel/kernel-cache/**": true,
    "**/kernel/build/**": true
  }
}
